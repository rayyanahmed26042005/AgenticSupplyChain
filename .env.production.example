# Agentic Supply Chain Orchestrator - Production Environment Configuration
# Copy this file to .env.production when setting up production variables

# ============= APP MODE =============
APP_MODE=simulation
# DataSource options: csv, manual, kaggle, kafka, api, database
DATA_SOURCE=manual

# ============= DATABASE (PostgreSQL) =============
# Postgres connection string used in docker-compose for production
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres/supply_chain

# ============= CACHE (Redis) =============
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# ============= MONGODB ATLAS (Persistence) =============
# MongoDB Connection URI for syncing datasets, manual records, and simulation history
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ============= SECURITY & AUTH =============
JWT_SECRET=productionsecretkeychangeinprod12345!
JWT_ALGORITHM=HS256

# ============= LLM/AI AGENTS (Groq / OpenAI) =============
# Toggle to true if you want agents to run using LLM prompts rather than analytical rules
USE_LLM_AGENTS=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# ============= API SERVER CONFIG =============
API_HOST=0.0.0.0
API_PORT=8000
# Update these to reflect your production domain name or load balancer URL
CORS_ORIGINS=["https://app.yourdomain.com", "http://localhost"]

# ============= LOGGING & DEBUG =============
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=production
