# Agentic Supply Chain Orchestrator - Environment Configuration
# Copy this file to .env and customize

# ============= MODE =============
APP_MODE=simulation
DATA_SOURCE=manual

# ============= DATABASE =============
DATABASE_URL=sqlite+aiosqlite:///./data/supply_chain.db

# ============= REDIS =============
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ============= SIMULATION =============
SIMULATION_ENABLED=true
SIMULATION_SPEED=1.0
PRELOAD_KAGGLE_DATA=false
KAGGLE_DATA_PATH=./data/kaggle
SIMULATION_SEED=42
DEFAULT_SIMULATION_DAYS=90
DEFAULT_DISRUPTIONS=3

# ============= ML/AI =============
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
USE_LLM_AGENTS=false
ENABLE_EXPLAINABILITY=true

# ============= API =============
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============= LOGGING =============
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development
